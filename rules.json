{
  "$schema": "https://parksubeom.github.io/bumpist-code/schemas/rules/v0.json",
  "version": "0.5.1",
  "rules": [
    {
      "id": "CORE-001",
      "title": "명시되지 않은 패키지, 설정을 임의로 추가하지 않는다.",
      "severity": "error",
      "enforcement": [
        "review"
      ],
      "status": "enforced",
      "file": "rules/10-guardrails.md",
      "section": "1. 기본 원칙",
      "line": 14
    },
    {
      "id": "CORE-002",
      "title": "기존 구조나 설정을 변경해야 하는 경우 반드시 변경 사유를 먼저 설명한다.",
      "severity": "error",
      "enforcement": [
        "review"
      ],
      "status": "enforced",
      "file": "rules/10-guardrails.md",
      "section": "1. 기본 원칙",
      "line": 16
    },
    {
